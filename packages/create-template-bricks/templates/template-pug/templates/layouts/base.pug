block components
    include ../shared/ui/head/index
    include ../shared/lib/blocks
    include ../widgets/footer/index

doctype html
html.no-js(lang=site.lang)
    +Head(head.default)
    body()&attributes(page.attrs)
        | %symbols%
        .page-wrapper
            block header
            main.page-content&attributes(page.content)
                block content
            block footer
                +Footer()
        block bottom
            script(src=asset('js/vendor.js') + version)
            script(src=asset('js/main.js') + version)
